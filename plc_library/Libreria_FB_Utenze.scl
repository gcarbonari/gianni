(*
------------------------------------------------------------------------------
Esempio di chiamata in OB1 (ciclo):

   "IDB_Router"(Scambio := "DB_ScambioHMI".Dati);

   "IDB_Valvola_1"(Enable := TRUE,
                   FcAperto := I_FcAperto,
                   FcChiuso := I_FcChiuso,
                   ResetTotale := "DB_ScambioHMI".Dati.Slot[1].Cmd.ResetUnita,
                   Slot := "DB_ScambioHMI".Dati.Slot[1],
                   ApriY => Q_Apri,
                   ChiudiY => Q_Chiudi);

   // HMI:
   //  Reset totale  -> Dati.ResetTotale := TRUE
   //  Reset utenza  -> Dati.IdxUnita := 5; Dati.ResetUnita := TRUE
   //  Reset allarme -> Dati.IdxUnita := 5; Dati.IdxAllarme := 2; Dati.ResetAllarme := TRUE
   // TestStand code module: stesse aree del DB di scambio (tag identici all'HMI).
------------------------------------------------------------------------------
*)
